                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The idea",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Many crops follow a yearly cycle: cheap after harvest, dear before the next one. Comparing the same week across years shows whether today's price is unusual.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The lines",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The axis is the week of the year, Wk 01 to Wk 52 (some years have a Wk 53). Weeks run Monday to Sunday; Wk 01 holds the year's first Thursday (ISO standard), so 29 Dec 2025 to 4 Jan 2026 is Wk 01 of 2026. A line well above the others means an unusually dear year.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
