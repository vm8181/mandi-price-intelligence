                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "The cards",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "This week's price next to the lowest and highest week loaded so far. Position in range: 0% means this week is the cheapest so far, 100% the dearest.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
                    }
                  }
                ]
