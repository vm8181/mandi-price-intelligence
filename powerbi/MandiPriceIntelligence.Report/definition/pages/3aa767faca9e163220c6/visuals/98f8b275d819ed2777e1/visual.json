                      "fontSize": "8pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Selling?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Markets at the top paid the most. Check Days reported: a price from 1 day rests on less than one from 7. Reports counts price lines: one per variety and grade each day.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Compare like with like",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "A market's price can mix varieties and grades. Pick yours in Variety and Grade, or drill through to Market detail to see what each one fetched.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "vs state median",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How this market’s price compares with the middle market in its state (half the state’s markets paid more, half less). If the state’s middle market paid ₹2,000 a quintal, +12% means this market paid ₹2,240 and −12% means ₹1,760. ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
                    }
                  },
                  {
                    "value": "Selling: + is better. Buying: − is cheaper.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#000000"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": " ",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "8pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Why not the Price pulse number?",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Price pulse shows the All India median for the latest week. Here each market is averaged over the period first, so the two differ a little.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
