        {
          "properties": {
            "paragraphs": [
              {
                "textRuns": [
                  {
                    "value": "Where the data comes from",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "18pt",
                      "color": "#e0922f"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Source",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Variety-wise Daily Market Prices (AGMARKNET), Department of Agriculture and Farmers Welfare, published on data.gov.in.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "How it gets here",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Every night each day is downloaded state by state and proved complete: the states add up to the day’s total. Databricks then cleans it: standard names, quality rules, and a reconciliation that accounts for every row.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "What is left out",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Impossible prices (under ₹1) and broken rows are quarantined. One-off prices 10 times off a market's usual level are left out of averages but counted.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Not trading advice",
                    "textStyle": {
                      "fontWeight": "bold",
                      "fontFamily": "Segoe UI Semibold",
                      "fontSize": "14pt",
                      "color": "#111827"
                    }
                  }
                ]
              },
              {
                "textRuns": [
                  {
                    "value": "Prices are as reported by mandis. Check with the mandi before you travel or sell.",
                    "textStyle": {
                      "fontFamily": "Segoe UI",
                      "fontSize": "13pt",
                      "color": "#374151"
                    }
                  }
                ]
              }
            ]
          }
        }
      ]
