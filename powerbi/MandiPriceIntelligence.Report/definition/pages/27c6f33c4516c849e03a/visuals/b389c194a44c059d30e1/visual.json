                    }
                  }
                ],
                "horizontalTextAlignment": "left"
              },
              {
                "textRuns": [
                  {
                    "value": "Each point is one week (Monday to Sunday), dated by its Monday. Solid green weeks are final. Dashed amber weeks are provisional: markets are still reporting, so they can move a little.",
                    "textStyle": {
                      "fontFamily": "'Segoe UI', wf_segoe-ui_normal, helvetica, arial, sans-serif",
                      "fontSize": "13pt",
                      "color": "#374151"
