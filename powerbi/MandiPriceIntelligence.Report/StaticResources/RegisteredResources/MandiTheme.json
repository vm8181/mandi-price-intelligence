{
  "name": "Mandi Price Intelligence",
  "dataColors": [
    "#1F8A5B",
    "#E0922F",
    "#2563EB",
    "#C2410C",
    "#7C3AED",
    "#0E7C86",
    "#9CA3AF",
    "#DB2777"
  ],
  "background": "#FFFFFF",
  "foreground": "#111827",
  "tableAccent": "#1F8A5B",
  "good": "#1F8A5B",
  "neutral": "#E0922F",
  "bad": "#C2410C",
  "textClasses": {
    "callout": {
      "fontSize": 24,
      "fontFace": "Segoe UI Semibold",
      "color": "#111827"
    },
    "title": {
      "fontSize": 13,
      "fontFace": "Segoe UI Semibold",
      "color": "#111827"
    },
    "header": {
      "fontSize": 12,
      "fontFace": "Segoe UI Semibold",
      "color": "#111827"
    },
    "label": {
      "fontSize": 10,
      "fontFace": "Segoe UI",
      "color": "#374151"
    }
  },
  "visualStyles": {
    "*": {
      "*": {
        "background": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#FFFFFF"
              }
            },
            "transparency": 0
          }
        ],
        "border": [
          {
            "show": true,
            "color": {
              "solid": {
                "color": "#D9DEE5"
              }
            },
            "radius": 10
          }
        ],
        "dropShadow": [
          {
            "show": false
          }
        ]
      }
    },
    "page": {
      "*": {
        "background": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F7"
              }
            },
            "transparency": 0
          }
        ],
        "outspace": [
          {
            "color": {
              "solid": {
                "color": "#F3F5F7"
              }
            },
            "transparency": 0
          }
        ]
      }
    }
  }
